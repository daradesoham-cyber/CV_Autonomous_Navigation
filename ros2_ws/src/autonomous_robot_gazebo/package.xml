  <version>0.1.0</version>
  <description>Gazebo simulation worlds, launch files, and bridge configuration</description>
  <maintainer email="soham@example.com">Soham Darade</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
