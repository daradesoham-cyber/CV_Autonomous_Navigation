<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="maze_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>25 25</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>25 25</size></plane></geometry>
          <material><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer Walls (16m x 16m) -->
    <model name="maze_walls">
      <static>true</static>
      <link name="north"><pose>0 8 1 0 0 0</pose><collision name="c"><geometry><box><size>16.4 0.4 2</size></box></geometry></collision><visual name="v"><geometry><box><size>16.4 0.4 2</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link>
      <link name="south"><pose>0 -8 1 0 0 0</pose><collision name="c"><geometry><box><size>16.4 0.4 2</size></box></geometry></collision><visual name="v"><geometry><box><size>16.4 0.4 2</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link>
      <link name="east"><pose>8 0 1 0 0 0</pose><collision name="c"><geometry><box><size>0.4 16.4 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 16.4 2</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link>
      <link name="west"><pose>-8 0 1 0 0 0</pose><collision name="c"><geometry><box><size>0.4 16.4 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 16.4 2</size></box></geometry><material><diffuse>0.6 0.6 0.6 1</diffuse></material></visual></link>

      <!-- Internal Maze Partitions -->
      <link name="w1"><pose>-4 4 1 0 0 0</pose><collision name="c"><geometry><box><size>0.4 8 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 8 2</size></box></geometry><material><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link>
      <link name="w2"><pose>0 -2 1 0 0 0</pose><collision name="c"><geometry><box><size>0.4 8 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 8 2</size></box></geometry><material><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link>
      <link name="w3"><pose>4 2 1 0 0 0</pose><collision name="c"><geometry><box><size>0.4 8 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.4 8 2</size></box></geometry><material><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link>
      <link name="w4"><pose>2 4 1 0 0 0</pose><collision name="c"><geometry><box><size>4 0.4 2</size></box></geometry></collision><visual name="v"><geometry><box><size>4 0.4 2</size></box></geometry><material><diffuse>0.5 0.5 0.55 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
