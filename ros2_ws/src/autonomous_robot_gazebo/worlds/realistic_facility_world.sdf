    <!-- Dynamic Moving Obstacle 1: Autonomous Warehouse Cart -->
    <model name='dynamic_warehouse_cart'>
      <pose>8.0 3.2035 0.3 0 0 1.5708</pose>
      <link name='cart_link'>
        <inertial>
          <mass>25.0</mass>
          <inertia><ixx>1.5</ixx><iyy>1.5</iyy><izz>1.5</izz></inertia>
        </inertial>
        <collision name='cart_collision'>
          <geometry><box><size>1.2 0.8 0.6</size></box></geometry>
        </collision>
        <visual name='cart_visual'>
          <geometry><box><size>1.2 0.8 0.6</size></box></geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename='gz-sim-velocity-control-system' name='gz::sim::systems::VelocityControl'>
        <link_name>cart_link</link_name>
        <topic>/cart/cmd_vel</topic>
      </plugin>
    </model>

    <!-- Dynamic Moving Obstacle 2: Hospital Trolley (Patrols medical corridor along Y=-5.0) -->
    <model name='dynamic_hospital_trolley'>
      <pose>7.7935 -5.0 0.35 0 0 0</pose>
      <link name='trolley_link'>
        <inertial>
          <mass>18.0</mass>
