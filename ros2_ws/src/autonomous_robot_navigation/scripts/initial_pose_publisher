#!/usr/bin/env python3
"""
Initial Pose Publisher for AMCL Localization.
Automatically broadcasts the initial pose to /initialpose at startup,
monitors /amcl_pose until AMCL confirms localization, preventing
lifecycle manager deadlock and ensuring complete TF tree.
"""
import sys
import time
import math

ros_site = '/opt/ros/lyrical/lib/python3.14/site-packages'
if ros_site not in sys.path:
    sys.path.insert(0, ros_site)

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import PoseWithCovarianceStamped


def euler_to_quaternion(yaw):
    qz = math.sin(yaw / 2.0)
    qw = math.cos(yaw / 2.0)
    return 0.0, 0.0, qz, qw


class InitialPosePublisher(Node):
    def __init__(self):
        super().__init__('initial_pose_publisher')

        self.declare_parameter('initial_pose_x', 0.0)
        self.declare_parameter('initial_pose_y', -11.0)
        self.declare_parameter('initial_pose_yaw', 1.57)

        # Handle both float and string parameter types gracefully
        try:
            self.target_x = float(self.get_parameter('initial_pose_x').get_parameter_value().double_value)
        except Exception:
            self.target_x = float(self.get_parameter('initial_pose_x').get_parameter_value().string_value)

        try:
            self.target_y = float(self.get_parameter('initial_pose_y').get_parameter_value().double_value)
        except Exception:
            self.target_y = float(self.get_parameter('initial_pose_y').get_parameter_value().string_value)

        try:
            self.target_yaw = float(self.get_parameter('initial_pose_yaw').get_parameter_value().double_value)
        except Exception:
            self.target_yaw = float(self.get_parameter('initial_pose_yaw').get_parameter_value().string_value)

        self.pub = self.create_publisher(PoseWithCovarianceStamped, '/initialpose', 10)
        self.sub_amcl = self.create_subscription(
            PoseWithCovarianceStamped,
            '/amcl_pose',
            self._amcl_cb,
            10
        )

        self.amcl_confirmed = False
        self.publish_count = 0
        self.max_publishes = 25

        # Timer to broadcast pose (2 Hz)
        self.timer = self.create_timer(0.5, self._broadcast_pose)
        self.get_logger().info(
            f"InitialPosePublisher active for target [x={self.target_x:.2f}, y={self.target_y:.2f}, yaw={self.target_yaw:.2f} rad]"
        )

    def _amcl_cb(self, msg: PoseWithCovarianceStamped):
        if not self.amcl_confirmed:
            self.amcl_confirmed = True
            px = msg.pose.pose.position.x
            py = msg.pose.pose.position.y
            self.get_logger().info(
                f"[SUCCESS] AMCL confirmed localization at (x={px:.2f}, y={py:.2f})! Initial pose locked."
            )
            self.timer.cancel()

    def _broadcast_pose(self):
        if self.amcl_confirmed or self.publish_count >= self.max_publishes:
            return

        # Ensure simulation clock has started
        if self.get_clock().now().nanoseconds == 0:
            return

        msg = PoseWithCovarianceStamped()
        msg.header.frame_id = 'map'
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.pose.pose.position.x = self.target_x
        msg.pose.pose.position.y = self.target_y
        msg.pose.pose.position.z = 0.0

        qx, qy, qz, qw = euler_to_quaternion(self.target_yaw)
        msg.pose.pose.orientation.x = qx
        msg.pose.pose.orientation.y = qy
        msg.pose.pose.orientation.z = qz
        msg.pose.pose.orientation.w = qw

        cov = [0.0] * 36
        cov[0] = 0.25
        cov[7] = 0.25
        cov[35] = 0.0685
        msg.pose.covariance = cov

        self.pub.publish(msg)
        self.publish_count += 1
        self.get_logger().info(
            f"Broadcasting initial pose to /initialpose ({self.publish_count}/{self.max_publishes}): "
            f"x={self.target_x:.2f}, y={self.target_y:.2f}, yaw={self.target_yaw:.2f}"
        )


def main(args=None):
    rclpy.init(args=args)
    node = InitialPosePublisher()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
