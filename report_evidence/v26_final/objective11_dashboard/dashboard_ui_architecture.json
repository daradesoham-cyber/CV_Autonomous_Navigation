{
  "dashboard_server": "Flask HTTP REST & MJPEG Streamer",
  "port": 5050,
  "endpoints": [
    {
      "path": "/",
      "type": "HTML/JS Single Page Application"
    },
    {
      "path": "/api/camera_frame",
      "type": "Live JPEG Frame (YOLO annotated, raw, fused)"
    },
    {
      "path": "/api/telemetry",
      "type": "Full Robot State & Clearance JSON (10 Hz)"
    },
    {
      "path": "/api/status",
      "type": "System Health & Active Node List"
    },
    {
      "path": "/api/goal",
      "type": "POST Destination Dispatch"
    },
    {
      "path": "/api/control",
      "type": "POST Mission Control (PAUSE, RESUME, ABORT)"
    }
  ],
  "sub_50ms_latency_verified": true,
  "video_fps": 15.0
}